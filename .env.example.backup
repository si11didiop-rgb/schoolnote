# Nom de l'application, affiché dans les emails et certaines vues
APP_NAME=SchoolNote

# Environnement d'exécution : local en développement, production en prod
APP_ENV=local

# Clé de chiffrement Laravel (sessions, cookies) — générée via php artisan key:generate
APP_KEY=base64:aWh2IdxmOvtveaSxwTHhv4ac+CTjrYUW3Yv+w8c8sus=

# Active les messages d'erreur détaillés (à mettre à FALSE en production !)
APP_DEBUG=true

# URL de base de l'application
APP_URL=http://127.0.0.1:8000

# Langue de l'application et des messages de validation
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

# Nombre de "rounds" pour le hachage des mots de passe (sécurité)
BCRYPT_ROUNDS=12

# Configuration des logs applicatifs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Connexion à la base de données MySQL/MariaDB (via XAMPP en local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolnote
DB_USERNAME=root
DB_PASSWORD=

# Stockage des sessions utilisateur en base de données
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Les emails (notes, bulletins, contact) sont mis en file d'attente
# et traités en base de données via php artisan queue:work
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Configuration email : Mailtrap (boîte de test, aucun email réel n'est envoyé)
# Permet de vérifier le contenu des emails sans polluer de vraies boîtes mail
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=2292723363605f
MAIL_PASSWORD=5eb8ef994d8824
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@schoolnote.fr"
MAIL_FROM_NAME="SchoolNote"

# Adresse recevant les messages du formulaire de contact public
MAIL_ADMIN_ADDRESS="admin@schoolnote.fr"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"